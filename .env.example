# Variables de entorno - El Café de Tus Ojos
PORT=3000
NODE_ENV=production

# Clave secreta para JWT (puedes usar cualquier cadena segura)
JWT_SECRET=Cualquierclaveesbuena

ADMIN_USER=admin
ADMIN_PASSWORD=german

# true = muestra el botón "Ingresar como Demo Admin (1-Clic)". Pon false para un cliente real.
DEMO_MODE=true

BUSINESS_NAME=El Café de Tus Ojos
# Formato internacional sin "+" ni espacios (México: 52 + 10 dígitos)
BUSINESS_WHATSAPP_PHONE=2382528801
BUSINESS_CLABE=722969020208857289
BUSINESS_BANK=MErcado Libre

# Opcional para Render: si lo defines, el servidor se auto-pingea cada 12 min para nunca suspenderse
RENDER_EXTERNAL_URL=

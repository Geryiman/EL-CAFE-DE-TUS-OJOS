# Copia este archivo a .env y completa los valores. NUNCA subas .env a GitHub.
PORT=3000
NODE_ENV=development

# Genera uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

ADMIN_USER=admin
ADMIN_PASSWORD=

# true = muestra el botón "Ingresar como Demo Admin (1-Clic)". Pon false para un cliente real.
DEMO_MODE=true

BUSINESS_NAME=El Café de Tus Ojos
